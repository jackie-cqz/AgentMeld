# AgentMeld example environment file.
#
#   cp .env.example .env.local
#
# Everything here is optional. .env.local is loaded automatically by Next.js;
# the benchmark/evaluation scripts load .env.local first and then .env (see
# scripts/load-env.mjs). Keys can also be entered in the in-app settings panel.

# ---------------------------------------------------------------------------
# Local data directory
# ---------------------------------------------------------------------------

# Directory for the SQLite database, workspaces, previews and run artifacts.
# Defaults to .agentmeld-data/ next to the project root.
AGENTMELD_DATA_DIR=.agentmeld-data

# Database file path. Only read by drizzle-kit (pnpm db:push); the running app
# always derives its database path from AGENTMELD_DATA_DIR.
AGENTMELD_DB_PATH=.agentmeld-data/agentmeld.db

# ---------------------------------------------------------------------------
# Model provider keys and base URLs
# ---------------------------------------------------------------------------
# Set only the providers you use. A per-agent key overrides the global one,
# which overrides these environment variables.

# DeepSeek (recommended provider)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI (also used as the Codex fallback key)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com

# Codex adapter key (falls back to OPENAI_API_KEY when unset)
CODEX_API_KEY=your_codex_api_key_here

# Anthropic / Claude Code
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Some gateways expose a bearer token instead of an API key.
ANTHROPIC_AUTH_TOKEN=your_anthropic_auth_token_here
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Volcano Ark
ARK_API_KEY=your_ark_api_key_here

# ---------------------------------------------------------------------------
# Benchmark / evaluation only
# ---------------------------------------------------------------------------
# Read by tests/e2e-runner and tests/agent-benchmark; not needed to run the app.

# Base URL of the running AgentMeld instance that benchmark cases talk to.
AGENTMELD_API_BASE=http://localhost:3000

# Output directory for benchmark runs. Defaults to .agentmeld-benchmark-data/.
AGENTMELD_BENCH_OUTPUT_DIR=.agentmeld-benchmark-data

# Context strategy for benchmark runs.
# Defaults to evidence_aware_context_with_role_contracts;
# the other built-in value is evidence_aware_context.
AGENTMELD_CONTEXT_STRATEGY=evidence_aware_context_with_role_contracts

# Set to 1 to enable injected benchmark faults; any other value skips them.
AGENTMELD_BENCH_FAULT_INJECTION=0

# Semantic judge used by benchmark runs.
AGENTMELD_JUDGE_API_KEY=your_judge_api_key_here
AGENTMELD_JUDGE_API_BASE=https://api.openai.com/v1
AGENTMELD_JUDGE_MODEL=gpt-5.1
