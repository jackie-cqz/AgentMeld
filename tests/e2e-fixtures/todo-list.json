{
  "schemaVersion": 1,
  "id": "todo-list-basic",
  "title": "Todo List",
  "description": "Classic CRUD Todo List exercising the complete PM, UI, Frontend, and Reviewer collaboration chain.",
  "category": "collaboration",
  "prompt": "帮我做一个 Todo List Web App。React，绿色主题，不需要登录。支持添加、完成、删除任务，支持按状态筛选（全部/进行中/已完成）。",
  "expectedRoles": ["pm", "ui", "frontend", "reviewer"],
  "assertions": [
    { "id": "role-pm-complete", "type": "role_executed", "role": "pm", "mustComplete": true, "required": true },
    { "id": "role-ui-complete", "type": "role_executed", "role": "ui", "mustComplete": true, "required": true },
    { "id": "role-frontend-complete", "type": "role_executed", "role": "frontend", "mustComplete": true, "required": true },
    { "id": "role-reviewer-complete", "type": "role_executed", "role": "reviewer", "mustComplete": true, "required": true },
    { "id": "output-prd", "type": "output_binding", "role": "pm", "outputKey": "prd", "artifactType": "document", "required": true },
    { "id": "output-style-guide", "type": "output_binding", "role": "ui", "outputKey": "style-guide", "artifactType": "document", "required": true },
    { "id": "output-web-app", "type": "output_binding", "role": "frontend", "outputKey": "web_app", "artifactType": "web_app", "required": true },
    { "id": "output-review-report", "type": "output_binding", "role": "reviewer", "outputKey": "review_report", "artifactType": "document", "required": true },
    { "id": "edge-pm-ui", "type": "dag_edge", "fromRole": "pm", "toRole": "ui", "outputKey": "prd", "required": true },
    { "id": "edge-pm-frontend", "type": "dag_edge", "fromRole": "pm", "toRole": "frontend", "outputKey": "prd", "required": true },
    { "id": "edge-ui-frontend", "type": "dag_edge", "fromRole": "ui", "toRole": "frontend", "outputKey": "style-guide", "required": true },
    { "id": "edge-frontend-reviewer", "type": "dag_edge", "fromRole": "frontend", "toRole": "reviewer", "outputKey": "web_app", "required": true },
    { "id": "ui-read-prd", "type": "artifact_read", "producerRole": "pm", "consumerRole": "ui", "outputKey": "prd", "requireVerifiedBinding": true, "required": true },
    { "id": "frontend-read-prd", "type": "artifact_read", "producerRole": "pm", "consumerRole": "frontend", "outputKey": "prd", "requireVerifiedBinding": true, "required": true },
    { "id": "frontend-read-style", "type": "artifact_read", "producerRole": "ui", "consumerRole": "frontend", "outputKey": "style-guide", "requireVerifiedBinding": true, "required": true },
    { "id": "reviewer-read-web-app", "type": "artifact_read", "producerRole": "frontend", "consumerRole": "reviewer", "outputKey": "web_app", "requireVerifiedBinding": true, "required": true },
    { "id": "frontend-write-source", "type": "tool_succeeded", "toolName": "fs_write", "role": "frontend", "required": true },
    { "id": "frontend-build", "type": "tool_succeeded", "toolName": "bash", "role": "frontend", "commandPattern": "build", "required": true },
    { "id": "frontend-deploy", "type": "deployment_ready", "role": "frontend", "outputKey": "web_app", "required": true }
  ],
  "limits": { "maxDurationMs": 900000, "maxToolCalls": 80, "maxAttemptsPerTask": 3 },
  "tags": ["web-app", "react", "full-chain", "smoke"]
}
