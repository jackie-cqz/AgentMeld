{
  "schemaVersion": 1,
  "id": "tb2d-video-jump-analyzer",
  "title": "TB2-Derived Video Jump Analyzer",
  "description": "Implements a constrained OpenCV analyzer and validates temporal localization on hidden synthetic videos.",
  "category": "context_handoff",
  "prompt": "这是 PM -> 前端工程师 -> Reviewer 的视频算法任务。PM 读取 README.md 并检查 example_video.mp4，输出 outputKey=video-contract，固定 CLI、output.toml 两个字段、依赖白名单和误差要求。前端工程师读取契约，使用 fs_write 创建 jump_analyzer.py，只能使用标准库、cv2、numpy、toml，运行 python jump_analyzer.py example_video.mp4 并输出 outputKey=jump-analyzer。Reviewer 读取算法和公开结果证据，检查非硬编码、takeoff < land、依赖边界和泛化解释，输出 outputKey=accuracy-review。禁止按文件名或固定帧返回结果。每个角色必须 report_task_result。",
  "expectedRoles": ["pm", "frontend", "reviewer"],
  "assertions": [
    { "id": "role-pm", "type": "role_executed", "role": "pm", "mustComplete": true, "required": true },
    { "id": "role-frontend", "type": "role_executed", "role": "frontend", "mustComplete": true, "required": true },
    { "id": "role-reviewer", "type": "role_executed", "role": "reviewer", "mustComplete": true, "required": true },
    { "id": "output-contract", "type": "output_binding", "role": "pm", "outputKey": "video-contract", "artifactType": "document", "required": true },
    { "id": "output-analyzer", "type": "output_binding", "role": "frontend", "outputKey": "jump-analyzer", "artifactType": "document", "required": true },
    { "id": "output-review", "type": "output_binding", "role": "reviewer", "outputKey": "accuracy-review", "artifactType": "document", "required": true },
    { "id": "edge-contract", "type": "dag_edge", "fromRole": "pm", "toRole": "frontend", "outputKey": "video-contract", "required": true },
    { "id": "edge-review", "type": "dag_edge", "fromRole": "frontend", "toRole": "reviewer", "outputKey": "jump-analyzer", "required": true },
    { "id": "frontend-read", "type": "artifact_read", "producerRole": "pm", "consumerRole": "frontend", "outputKey": "video-contract", "requireVerifiedBinding": true, "required": true },
    { "id": "reviewer-read", "type": "artifact_read", "producerRole": "frontend", "consumerRole": "reviewer", "outputKey": "jump-analyzer", "requireVerifiedBinding": true, "required": true },
    { "id": "write-analyzer", "type": "tool_succeeded", "toolName": "fs_write", "role": "frontend", "required": true },
    { "id": "run-analyzer", "type": "tool_succeeded", "toolName": "bash", "role": "frontend", "commandPattern": "python.*jump_analyzer", "required": true },
    { "id": "analyzer-script", "type": "workspace_file", "path": "jump_analyzer.py", "minBytes": 100, "required": true },
    { "id": "public-output", "type": "workspace_file", "path": "output.toml", "minBytes": 20, "required": true },
    { "id": "video-protected", "type": "no_forbidden_mutation", "paths": ["README.md", "example_video.mp4"], "required": true },
    { "id": "jump-hidden", "type": "command_verifier", "verifierId": "jump-hidden", "required": true },
    { "id": "reviewer-verified", "type": "verification_status", "role": "reviewer", "expected": "verified", "required": true }
  ],
  "runtime": {
    "assetBundle": {
      "root": "tests/e2e-assets/tb2d-video-jump-analyzer",
      "setupCommands": [{ "id": "generate-video-set", "command": "python setup/generate_videos.py", "timeoutMs": 180000 }],
      "generatedPublicDir": "generated/public",
      "generatedHiddenDir": "generated/hidden"
    },
    "verifiers": [{ "id": "jump-hidden", "command": "python .benchmark/hidden/verify_jump.py", "timeoutMs": 180000, "expectedExitCode": 0 }]
  },
  "judge": { "enabled": true, "requiredForPass": false, "rubricVersion": "collaboration-rubric-v1", "dimensions": ["requirement_coverage", "implementation_fidelity", "review_quality", "final_summary_accuracy"] },
  "limits": { "maxDurationMs": 1800000, "maxModelCalls": 18, "maxToolCalls": 60, "maxAttemptsPerTask": 2 },
  "tags": ["terminal-bench-2-derived", "video", "opencv", "numeric", "hidden-verifier"]
}
